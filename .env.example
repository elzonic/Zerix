# Zerix — example environment configuration
# Copy to .env and fill in according to your deployment.

# --- API / Cloud ---
ZERIX_API_KEY=zx_live_xxxxxxxxxxxxxxxx
ZERIX_BASE_URL=https://api.zerix.dev

# --- Database (self-hosted) ---
ZERIX_DB_URL=postgresql://zerix:zerix@localhost:5432/zerix

# --- Signer Provider ---
# Choose one: turnkey | privy | coinbase_agentkit | mock
ZERIX_SIGNER_PROVIDER=turnkey
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=

# --- Webhook (optional) ---
ZERIX_WEBHOOK_URL=
ZERIX_WEBHOOK_SECRET=

# --- Observability ---
ZERIX_LOG_LEVEL=info
